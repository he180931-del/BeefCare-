# Local development only. Copy to .env and replace BOTH example passwords.
BEEFCARE_DB_PASSWORD=replace-with-a-local-database-password
BEEFCARE_DEV_PASSWORD=replace-with-a-local-demo-password
BEEFCARE_DB_URL=jdbc:postgresql://localhost:15432/beefcare
BEEFCARE_DB_USERNAME=beefcare
BEEFCARE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BEEFCARE_PUBLIC_URL=http://localhost:5173
BEEFCARE_BACKEND_URL=http://localhost:8080
# Server-only; replace with at least 32 random characters. Never expose in frontend variables.
BEEFCARE_LINK_SECRET=replace-with-a-long-random-server-only-signing-secret


# Local development only. Copy to .env and replace BOTH example passwords.
BEEFCARE_DB_PASSWORD=replace-with-a-local-database-password
BEEFCARE_DEV_PASSWORD=replace-with-a-local-demo-password
BEEFCARE_DB_URL=jdbc:postgresql://localhost:15432/beefcare
BEEFCARE_DB_USERNAME=beefcare
BEEFCARE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BEEFCARE_PUBLIC_URL=http://localhost:5173
BEEFCARE_BACKEND_URL=http://localhost:8080
BEEFCARE_GOOGLE_ENABLED=false
# Configure these only in your uncommitted environment file. Google callback: ${BEEFCARE_BACKEND_URL}/login/oauth2/code/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
# Local SMTP: Mailpit catches mail at http://localhost:8025 and never sends it to the Internet.
BEEFCARE_EMAIL_PROVIDER=smtp
BEEFCARE_SMTP_HOST=localhost
BEEFCARE_SMTP_PORT=1025
BEEFCARE_SMTP_USERNAME=
BEEFCARE_SMTP_PASSWORD=
BEEFCARE_SMTP_AUTH=false
BEEFCARE_SMTP_STARTTLS_ENABLE=false
BEEFCARE_SMTP_STARTTLS_REQUIRED=false
BEEFCARE_MAIL_FROM=BeefCare@gmail.com
# Production overrides these values with smtp.gmail.com:587, BeefCare@gmail.com and a Google App Password.
# Create an App Password only after enabling Google's 2-Step Verification; never use the Gmail account password.
# Server-only; replace with at least 32 random characters. Never expose in frontend variables.
BEEFCARE_LINK_SECRET=replace-with-a-long-random-server-only-signing-secret

    <!--
        Added the constraints for entity Subscription.
    -->
    <changeSet id="20261019174020-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="farm_id"
                                 baseTableName="subscription"
                                 constraintName="fk_subscription__farm_id"

                                 />

        <addForeignKeyConstraint baseColumnNames="purpose_id"
                                 baseTableName="cattle"
                                 constraintName="fk_cattle__purpose_id"
                                 referencedColumnNames="id"
                                 referencedTableName="production_purpose"
                                 />

        <addForeignKeyConstraint baseColumnNames="dam_id"
                                 baseTableName="cattle"
                                 constraintName="fk_cattle__dam_id"
                                 referencedColumnNames="id"
                                 referencedTableName="cattle"
                                 />

        <addForeignKeyConstraint baseColumnNames="sire_id"
                                 baseTableName="cattle"
                                 constraintName="fk_cattle__sire_id"
                                 referencedColumnNames="id"
                                 referencedTableName="cattle"
                                 />
    </changeSet>
</databaseChangeLog>

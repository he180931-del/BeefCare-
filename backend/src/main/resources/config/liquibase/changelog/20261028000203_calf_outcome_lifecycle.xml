<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="20261028000203-calf-outcome-lifecycle" author="beefcare">
    <addColumn tableName="calf_outcome">
      <column name="status" type="varchar(30)" defaultValue="VALID"><constraints nullable="false"/></column>
      <column name="status_reason" type="varchar(500)"/>
      <column name="is_corrected" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
    </addColumn>
    <addUniqueConstraint tableName="calf_outcome" columnNames="calving_id, calf_no" constraintName="uq_calf_outcome_number"/>
  </changeSet>
</databaseChangeLog>

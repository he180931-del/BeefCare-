    <dropNotNullConstraint tableName="medicine" columnName="dose" columnDataType="varchar(255)"/>
    <dropNotNullConstraint tableName="medicine" columnName="route" columnDataType="varchar(255)"/>
  </changeSet>
</databaseChangeLog>

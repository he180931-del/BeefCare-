<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="20261124000200-support-internal-request-active-role" author="beefcare">
    <!-- The original index covered OPEN only; WAITING_CS is also an active blocker. -->
    <sql dbms="postgresql">
      DROP INDEX IF EXISTS ux_internal_open_per_role;
      CREATE UNIQUE INDEX ux_internal_active_per_role
        ON internal_request(ticket_id,target_role)
        WHERE state IN ('OPEN','WAITING_CS');
    </sql>
  </changeSet>
</databaseChangeLog>

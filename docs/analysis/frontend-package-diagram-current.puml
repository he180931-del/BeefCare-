@startuml
title BeefCare Frontend — UML Package Diagram (Current State)

top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle folder
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowFontSize 10

package "frontend / src" as SRC {
  artifact "main.tsx" <<module>> as MAIN
  artifact "App.tsx" <<router module>> as APP
  artifact "types.ts" <<type module>> as TYPES

  package "api" as API
  package "components" as COMPONENTS
  package "hooks" as HOOKS
  package "data" as DATA
  package "assets" as ASSETS
  package "pages" as PAGES

  package "features" as FEATURES {
    package "authentication" as AUTHENTICATION
    package "authorization" as AUTHORIZATION
    package "account" as ACCOUNT
    package "farm-workspace" as FARM_WORKSPACE

    package "cattle" as CATTLE
    package "pen-management" as PEN_MANAGEMENT
    package "herd-entry" as HERD_ENTRY
    package "herd-exit" as HERD_EXIT

    package "growth" as GROWTH
    package "vaccination" as VACCINATION
    package "health" as HEALTH
    package "reproduction" as REPRODUCTION

    package "farm-overview" as FARM_OVERVIEW
    package "farm-announcements" as FARM_ANNOUNCEMENTS
    package "farm-catalogue" as FARM_CATALOGUE
    package "feed-stock" as FEED_STOCK

    package "notifications" as NOTIFICATIONS
    package "subscription" as SUBSCRIPTION
    package "support" as SUPPORT
    package "platform-admin" as PLATFORM_ADMIN

    package "platform-service" as PLATFORM_SERVICE
    package "platform-finance" as PLATFORM_FINANCE
    package "platform-support" as PLATFORM_SUPPORT

    AUTHENTICATION -[hidden]right-> AUTHORIZATION
    AUTHORIZATION -[hidden]right-> ACCOUNT
    ACCOUNT -[hidden]right-> FARM_WORKSPACE

    AUTHENTICATION -[hidden]down-> CATTLE
    AUTHORIZATION -[hidden]down-> PEN_MANAGEMENT
    ACCOUNT -[hidden]down-> HERD_ENTRY
    FARM_WORKSPACE -[hidden]down-> HERD_EXIT

    CATTLE -[hidden]right-> PEN_MANAGEMENT
    PEN_MANAGEMENT -[hidden]right-> HERD_ENTRY
    HERD_ENTRY -[hidden]right-> HERD_EXIT

    CATTLE -[hidden]down-> GROWTH
    PEN_MANAGEMENT -[hidden]down-> VACCINATION
    HERD_ENTRY -[hidden]down-> HEALTH
    HERD_EXIT -[hidden]down-> REPRODUCTION

    GROWTH -[hidden]right-> VACCINATION
    VACCINATION -[hidden]right-> HEALTH
    HEALTH -[hidden]right-> REPRODUCTION

    GROWTH -[hidden]down-> FARM_OVERVIEW
    VACCINATION -[hidden]down-> FARM_ANNOUNCEMENTS
    HEALTH -[hidden]down-> FARM_CATALOGUE
    REPRODUCTION -[hidden]down-> FEED_STOCK

    FARM_OVERVIEW -[hidden]right-> FARM_ANNOUNCEMENTS
    FARM_ANNOUNCEMENTS -[hidden]right-> FARM_CATALOGUE
    FARM_CATALOGUE -[hidden]right-> FEED_STOCK

    FARM_OVERVIEW -[hidden]down-> NOTIFICATIONS
    FARM_ANNOUNCEMENTS -[hidden]down-> SUBSCRIPTION
    FARM_CATALOGUE -[hidden]down-> SUPPORT
    FEED_STOCK -[hidden]down-> PLATFORM_ADMIN

    NOTIFICATIONS -[hidden]right-> SUBSCRIPTION
    SUBSCRIPTION -[hidden]right-> SUPPORT
    SUPPORT -[hidden]right-> PLATFORM_ADMIN

    NOTIFICATIONS -[hidden]down-> PLATFORM_SERVICE
    SUBSCRIPTION -[hidden]down-> PLATFORM_FINANCE
    SUPPORT -[hidden]down-> PLATFORM_SUPPORT

    PLATFORM_SERVICE -[hidden]right-> PLATFORM_FINANCE
    PLATFORM_FINANCE -[hidden]right-> PLATFORM_SUPPORT
  }

  MAIN -[hidden]right-> APP
  APP -[hidden]right-> TYPES
  API -[hidden]right-> COMPONENTS
  COMPONENTS -[hidden]right-> HOOKS
  HOOKS -[hidden]right-> DATA
  DATA -[hidden]right-> ASSETS
  ASSETS -[hidden]right-> PAGES

  MAIN -[hidden]down-> API
  API -[hidden]down-> FEATURES
}

MAIN ..> APP : <<use>>
MAIN ..> AUTHENTICATION : <<use>>
MAIN ..> AUTHORIZATION : <<use>>
APP ..> FEATURES : <<use>> route loaders
APP ..> PAGES : <<use>> fallback page

FEATURES ..> API : <<use>>
FEATURES ..> COMPONENTS : <<use>>
FEATURES ..> HOOKS : <<use>>
FEATURES ..> DATA : <<use>> selected features
FEATURES ..> TYPES : <<use>> shared domain types

API ..> DATA : <<use>> local/demo adapters
API ..> TYPES : <<use>>
COMPONENTS ..> ASSETS : <<use>>
COMPONENTS ..> AUTHORIZATION : <<use>> current Layout dependency
HOOKS ..> API : <<use>>
PAGES ..> COMPONENTS : <<use>>

AUTHENTICATION ..> AUTHORIZATION : <<use>> current cycle
AUTHORIZATION ..> AUTHENTICATION : <<use>> current cycle

note bottom of FEATURES
  Some feature packages currently use other feature packages directly,
  especially cattle profile tabs, subscription/workspace and herd-exit/cattle.
end note

note bottom of SRC
  Packages use the UML folder symbol.
  main.tsx, App.tsx and types.ts are modules/artifacts, not directories.
  <<use>> represents source-level dependency; it is not UML PackageImport.
end note

caption Figure: BeefCare Frontend UML Package Diagram — Current State
@enduml

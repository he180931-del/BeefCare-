# Copy to frontend/.env (Vite does not read this example file).
# Use the real Spring Boot API. Change to "local" only for the offline prototype.
VITE_BEEFCARE_DATA_SOURCE=backend
# Leave empty so requests use the relative /api path through the Vite proxy (vite.config.js).
# Set a backend origin only when the proxy cannot be used; the backend must then allow it in BEEFCARE_CORS_ORIGINS.
VITE_BEEFCARE_API_URL=
# Google OAuth always starts at the Spring Boot backend. Leave API_URL empty for the Vite proxy.
# The registered Google callback is ${BEEFCARE_BACKEND_URL}/login/oauth2/code/google.
# There is no default farm: the farm comes from Select Farm (UC-FE02-02), kept per browser tab.

# Optional trusted HTTPS certificate/key for scanning with a phone on the local network.
# Both paths are required. The phone must trust the certificate and use its matching hostname/IP.
# BEEFCARE_DEV_HTTPS_CERT=C:/certificates/beefcare-local.pem
# BEEFCARE_DEV_HTTPS_KEY=C:/certificates/beefcare-local-key.pem

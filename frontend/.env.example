# Copy to frontend/.env (Vite does not read this example file).
# Use the real Spring Boot API. Change to "local" only for the offline prototype.
VITE_BEEFCARE_DATA_SOURCE=backend
# Leave empty so requests use the relative /api path through the Vite proxy (vite.config.js).
# Set a backend origin only when the proxy cannot be used; the backend must then allow it in BEEFCARE_CORS_ORIGINS.
VITE_BEEFCARE_API_URL=
VITE_BEEFCARE_FARM_ID=1

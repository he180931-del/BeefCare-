{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "test": "npm run test:api && npm run test:unit:run && npm run test:integration",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:unit": "vitest",
    "test:unit:run": "vitest run --passWithNoTests",
    "test:integration": "node --import tsx --test tests/integration/herd-entry/*.test.ts",
    "test:integration:ui": "vitest run tests/integration/**/*.test.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "read-excel-file": "^5.8.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
